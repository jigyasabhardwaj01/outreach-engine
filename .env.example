# Copy to .env and fill in. Never commit the real file — .gitignore covers it.

# Which campaign to run: a file in profiles/.
PROFILE=profiles/compliance-saas.js

# Research and drafting: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=
# Minimum milliseconds between model calls, to stay inside the free tier.
GEMINI_MIN_GAP_MS=1000

# Finds the contact: https://hunter.io/api-keys
HUNTER_API_KEY=
# Sends approved emails: https://resend.com/api-keys
RESEND_API_KEY=

# Every email goes here and nowhere else, whoever the contact turns out to be.
EMAIL_TO=
EMAIL_FROM=onboarding@resend.dev

# true: you approve each company and each email before anything is sent.
REVIEW_MODE=true
PORT=3000
