{
  "compilerOptions": {
    "target": "es2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": [
      "es2023",
      "dom"
    ],
    "checkJs": true,
    "allowJs": true,
    "noEmit": true,
    "strict": false,
    "noImplicitAny": false,
    "noUnusedLocals": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true
  },
  "include": [
    "src/**/*.js",
    "api/**/*.js",
    "public/**/*.js",
    "profiles/**/*.js",
    "cli.js"
  ],
  "exclude": [
    "node_modules",
    "reference",
    "test"
  ]
}
