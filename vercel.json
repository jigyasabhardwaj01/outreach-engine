{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "public",
  "regions": ["sin1"],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "no-store, must-revalidate" }]
    }
  ],
  "functions": {
    "api/*.js": {
      "maxDuration": 60,
      "includeFiles": "profiles/**"
    }
  }
}
